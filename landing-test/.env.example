# Copier ce fichier en .env (ne jamais commiter .env)

# URL publique du site. NewebPay doit pouvoir joindre NOTIFY_URL en ligne :
# en local, utiliser un tunnel (ex. ngrok) et mettre l'URL du tunnel ici.
BASE_URL=http://localhost:3000
PORT=3000

# Compte marchand NewebPay (test). Laisser vide = mode SIMULATION (aucun appel NewebPay).
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
# Test : https://ccore.newebpay.com/MPG/mpg_gateway
# Production : https://core.newebpay.com/MPG/mpg_gateway
NEWEBPAY_GATEWAY=https://ccore.newebpay.com/MPG/mpg_gateway

# Produit : prix affiché en euros (TTC)
PRODUCT_NAME=灣灣好日子 野生動物版
PRICE_EUR=19.90
# Frais de port par commande, en euros (0 = offerts, ligne masquée). À définir.
SHIPPING_EUR=0

# NewebPay encaisse en TWD : le serveur convertit le prix en euros avec ce taux fixe
# (1 EUR = X TWD) et envoie un montant TWD entier. À METTRE À JOUR régulièrement.
EUR_TWD_RATE=35

# ---------- Airwallex (Hosted Payment Page : cartes, Apple Pay, Google Pay) ----------
# Si CLIENT_ID et API_KEY sont renseignés, Airwallex remplace NewebPay et le mode simulation.
# Ces valeurs se saisissent dans Vercel (Settings > Environment Variables), jamais dans GitHub.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# demo = environnement de test (api.sandbox.airwallex.com) | prod = production (api.airwallex.com)
AIRWALLEX_ENV=demo
# Clé de signature du webhook (Airwallex > Developer > Webhooks). URL : https://wanwanplay.com/airwallex/webhook
AIRWALLEX_WEBHOOK_SECRET=
# Pays de la société, requis pour Apple Pay / Google Pay (à confirmer avec Airwallex : TW ou HK)
AIRWALLEX_COUNTRY_CODE=TW

# ---------- Stockage des commandes et codes promo sur Vercel ----------
# Disque éphémère sur Vercel : ajouter une base Upstash Redis (Vercel > Storage / Marketplace).
# Les variables ci-dessous sont créées automatiquement par l'intégration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
