# Copy to .env for local use. Never commit secrets.
BASE_URL=http://localhost:3000
PORT=3000
PRODUCT_NAME=灣灣好日子 野生動物版
PRICE_EUR=19.90
# One deck: EUR 3.90. Two or more decks in one order: shipping is free.
# Replaces the old flat SHIPPING_EUR setting; old values no longer override this policy.
SINGLE_DECK_SHIPPING_EUR=3.90

# PayPal Business app credentials: use the matching sandbox or live account.
# Checkout stays closed until ALL five variables are present and ENV is valid.
# Enter secrets only in Hostinger environment variables (or an untracked local .env).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Business account Merchant ID; use the sandbox seller ID for sandbox tests.
PAYPAL_MERCHANT_ID=

# Backoffice at /backoffice/ (disabled when absent or shorter than 16 characters).
# Generate a unique random password with a password manager; enter it in Hostinger only.
ADMIN_PASSWORD=

# Order confirmation + team alert. Disabled until enabled and SMTP is configured.
# Hostinger Email mailbox credentials, NOT your Hostinger account password.
MAIL_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=play@wanwanplay.com
SMTP_PASSWORD=
MAIL_FROM=play@wanwanplay.com
MAIL_TO=play@wanwanplay.com
# Optional sandbox testing: both messages go to MAIL_TO by default.
MAIL_SANDBOX_ENABLED=false
# Opt in to sending sandbox buyer confirmations to the email returned by PayPal.
# Requires MAIL_SANDBOX_ENABLED=true too. Use a real inbox; dummy accounts cannot receive.
MAIL_SANDBOX_BUYER_ENABLED=false

# Optional private Google Sheets promo import: manual backoffice preview/apply.
# Enable Google Sheets API and share the sheet with this account as Viewer.
# Enter client_email and private_key only in Hostinger; never commit the JSON key.
# PRIVATE_KEY accepts real line breaks or literal \n sequences.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Keep the existing persistent directory outside the deployed site.
# Empty = landing-test/data; relative paths start at server.js.
DATA_DIR=
# Optional Redis takes precedence over files. Keep existing configuration.
# KV_REST_API_URL / KV_REST_API_TOKEN aliases are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
