# Serve the new landing page when Hostinger deploys the repository root.
RewriteEngine On

# Keep the public homepage at / while reading the landing page's entry point.
RewriteRule ^$ landing-test/public/index.html [L]

# Resolve the landing page's scripts and images from its public folder.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/landing-test/public/$1 -f
RewriteRule ^(.+)$ landing-test/public/$1 [L]

# Resolve relative CSS, JavaScript, images, and PDFs from the same build.
# Only rewrite to files that exist, so missing URLs remain normal 404s.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
RewriteRule ^(.+)$ dist/$1 [L]
